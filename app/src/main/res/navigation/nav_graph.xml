<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_sensor_list">

    <!-- 화면 1: 기간별 데이터 조회 -->
    <fragment
        android:id="@+id/nav_sensor_list"
        android:name="com.sensorlog.ui.main.SensorListFragment"
        android:label="@string/nav_sensor_list" />

    <!-- 화면 2: 최신 센서 값 -->
    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.sensorlog.ui.main.DashboardFragment"
        android:label="@string/nav_dashboard" />

    <!-- 화면 3: 임계값 설정 + 모니터링 -->
    <fragment
        android:id="@+id/nav_settings"
        android:name="com.sensorlog.ui.main.SettingsFragment"
        android:label="@string/nav_settings" />

</navigation>
